#!/usr/bin/env python3
"""Create a stable, locally managed Cloudflare Tunnel for the receiver."""

from __future__ import annotations

import json
from pathlib import Path
import shutil
import subprocess
import sys
from urllib.parse import urlsplit


REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "src"))

from iphone_cli.config import CONFIG_DIR, public_url, receiver_port  # noqa: E402


TUNNEL_NAME = "codex-ios-assistant"


def run(*arguments: str, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        arguments,
        check=True,
        text=True,
        capture_output=capture,
    )


def tunnel_id(cloudflared: str) -> str | None:
    result = run(cloudflared, "tunnel", "list", "--output", "json", capture=True)
    tunnels = json.loads(result.stdout)
    matches = [item for item in tunnels if item.get("name") == TUNNEL_NAME]
    if len(matches) > 1:
        raise SystemExit(f"Multiple Cloudflare tunnels are named {TUNNEL_NAME!r}.")
    return str(matches[0]["id"]) if matches else None


def main() -> int:
    cloudflared = shutil.which("cloudflared")
    if not cloudflared:
        raise SystemExit("cloudflared is missing. Install it with: brew install cloudflared")
    hostname = urlsplit(public_url()).hostname
    if not hostname:
        raise SystemExit("IPHONE_PUBLIC_URL does not contain a hostname.")

    certificate = Path.home() / ".cloudflared" / "cert.pem"
    if not certificate.is_file():
        print("Cloudflare authorization is required; a browser window will open.")
        run(cloudflared, "tunnel", "login")

    identifier = tunnel_id(cloudflared)
    if not identifier:
        run(cloudflared, "tunnel", "create", TUNNEL_NAME)
        identifier = tunnel_id(cloudflared)
    if not identifier:
        raise SystemExit("Cloudflare created no discoverable tunnel.")

    credentials = Path.home() / ".cloudflared" / f"{identifier}.json"
    if not credentials.is_file():
        raise SystemExit(f"Tunnel credentials are missing: {credentials}")

    configuration = CONFIG_DIR / "cloudflared.yml"
    previous_configuration = configuration.read_text() if configuration.is_file() else ""
    already_managed_here = (
        f"tunnel: {identifier}" in previous_configuration
        and f"hostname: {hostname}" in previous_configuration
    )

    route = subprocess.run(
        [cloudflared, "tunnel", "route", "dns", identifier, hostname],
        text=True,
        capture_output=True,
        check=False,
    )
    if route.returncode != 0:
        detail = route.stderr.strip() or route.stdout.strip() or "DNS route creation failed."
        if "already exists" not in detail.lower() or not already_managed_here:
            raise SystemExit(
                f"{detail}\nRefusing to overwrite an existing DNS record. Choose a free "
                "dedicated hostname, remove the old record in Cloudflare, or intentionally "
                "run 'cloudflared tunnel route dns --overwrite-dns "
                f"{identifier} {hostname}' and retry."
            )

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    CONFIG_DIR.chmod(0o700)
    configuration.write_text(
        f"tunnel: {identifier}\n"
        f"credentials-file: {credentials}\n"
        "ingress:\n"
        f"  - hostname: {hostname}\n"
        f"    service: http://127.0.0.1:{receiver_port()}\n"
        "  - service: http_status:404\n"
    )
    configuration.chmod(0o600)
    print(f"Configured Cloudflare Tunnel {TUNNEL_NAME!r} for https://{hostname}")
    print(f"Wrote {configuration}")
    print("Run ./scripts/install-services to keep the tunnel running at login.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
