#!/usr/bin/env python3
"""Create the private user configuration outside the repository."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import secrets
import shlex
from urllib.parse import urlsplit


CONFIG_DIR = Path(
    os.environ.get(
        "IOS_ASSISTANT_CONFIG_DIR",
        Path.home() / ".config" / "codex-ios-assistant",
    )
).expanduser()
CONFIG_FILE = CONFIG_DIR / "config.env"


def existing_values() -> dict[str, str]:
    values: dict[str, str] = {}
    if not CONFIG_FILE.is_file():
        return values
    for raw_line in CONFIG_FILE.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, raw_value = line.split("=", 1)
        parsed = shlex.split(raw_value.strip())
        values[name.strip()] = parsed[0] if parsed else ""
    return values


def prompt(label: str, current: str = "") -> str:
    suffix = f" [{current}]" if current else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or current


def quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main() -> int:
    parser = argparse.ArgumentParser(description="Configure codex-ios-assistant")
    parser.add_argument("--target", help="your own iMessage email address or phone number")
    parser.add_argument("--url", help="private Tailscale HTTPS receiver origin")
    parser.add_argument("--force-token", action="store_true", help="rotate both receiver tokens")
    args = parser.parse_args()

    current = existing_values()
    target = args.target or prompt(
        "iMessage address that reaches this iPhone", current.get("IPHONE_MSG_TARGET", "")
    )
    receiver_url = args.url or prompt(
        "Tailscale HTTPS origin (for example https://my-mac.tailnet-name.ts.net)",
        current.get("IPHONE_RECEIVER_URL", ""),
    )
    receiver_url = receiver_url.rstrip("/")
    parsed_url = urlsplit(receiver_url)
    try:
        parsed_port = parsed_url.port
    except ValueError:
        parser.error("--url contains an invalid port")
    if (
        parsed_url.scheme != "https"
        or not parsed_url.hostname
        or not parsed_url.hostname.rstrip(".").lower().endswith(".ts.net")
        or parsed_url.username is not None
        or parsed_url.password is not None
        or parsed_port is not None
        or parsed_url.path not in {"", "/"}
        or parsed_url.query
        or parsed_url.fragment
    ):
        parser.error("--url must be a private Tailscale HTTPS origin ending in .ts.net")
    if not target or any(character in target for character in "\r\n"):
        parser.error("--target must be a non-empty, single-line iMessage address")

    token = current.get("IPHONE_RECEIVER_TOKEN", "")
    if args.force_token or len(token) < 32:
        token = secrets.token_urlsafe(32)
    admin_token = current.get("IPHONE_RECEIVER_ADMIN_TOKEN", "")
    if args.force_token or len(admin_token) < 32:
        admin_token = secrets.token_urlsafe(32)
    command_prefix = current.get("IPHONE_COMMAND_PREFIX", "")
    if args.force_token or len(command_prefix) < 8:
        command_prefix = f"ios_{secrets.token_hex(8)}"

    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONFIG_DIR, 0o700)
    contents = (
        "# Generated by codex-ios-assistant/scripts/configure. Keep this file private.\n"
        f"IPHONE_MSG_TARGET={quote(target)}\n"
        f"IPHONE_RECEIVER_URL={quote(receiver_url)}\n"
        f"IPHONE_RECEIVER_TOKEN={quote(token)}\n"
        f"IPHONE_RECEIVER_ADMIN_TOKEN={quote(admin_token)}\n"
        f"IPHONE_COMMAND_PREFIX={quote(command_prefix)}\n"
    )
    temporary = CONFIG_FILE.with_suffix(".env.tmp")
    temporary.write_text(contents)
    os.chmod(temporary, 0o600)
    os.replace(temporary, CONFIG_FILE)
    print(f"Wrote private configuration to {CONFIG_FILE}")
    print("Receiver tokens were generated automatically and were not printed.")
    print(f"Use this exact Message automation filter: Message contains {command_prefix}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
